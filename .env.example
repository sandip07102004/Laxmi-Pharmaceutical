# ==========================================
# Laxmi Pharma - Environment Configuration Template
# ==========================================

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend Email Configuration
ORDER_RESEND_API_KEY=your_order_resend_api_key
ORDER_ADMIN_EMAIL=your_order_email@example.com

CONSULT_RESEND_API_KEY=your_consult_resend_api_key
CONSULT_ADMIN_EMAIL=your_help_email@example.com

RESEND_API_KEY=your_default_resend_api_key
ADMIN_EMAIL=your_admin_email@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_password
SMTP_SECURE=true
SENDER_EMAIL=onboarding@resend.dev

# Server Port
PORT=5000
